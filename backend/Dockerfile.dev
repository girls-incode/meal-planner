# syntax=docker/dockerfile:1

# Development Dockerfile for Rails backend with dev/test gems and live reload.
# Use with docker-compose.yml for local development.

ARG RUBY_VERSION=3.3.8
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Install dependencies: database client, build tools, image/vips support
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates curl libjemalloc2 libvips postgresql-client \
      build-essential git libpq-dev libyaml-dev pkg-config && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Development environment: dev/test gems included, logging to stdout
ENV RAILS_ENV="development" \
    BUNDLE_DEPLOYMENT="0" \
    BUNDLE_PATH="/usr/local/bundle" \
    RAILS_LOG_TO_STDOUT="true" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so"

# Install gems (includes dev/test dependencies for debugging and testing)
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Source code mounted as volume at runtime (no COPY here)

EXPOSE 3000

# Rails dev server binds to 0.0.0.0:3000 so docker-compose can expose port 3000
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3000"]
