# syntax=docker/dockerfile:1

# Development Dockerfile for Vite dev server with HMR.
# Use docker-compose with this file for local development with hot-module reloading.

FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install

# Copy source code
COPY . .

# Vite dev server binds to 0.0.0.0 and exposes on port 5173
EXPOSE 5173

# Run the Vite dev server with HMR enabled
# HMR is configured to connect via the host's 127.0.0.1:5173 for WSL2
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
